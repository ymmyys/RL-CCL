index 63936b8..e084c80 100644
--- a/fabric-lib/src/verbs/verbs_devinfo.rs
+++ b/fabric-lib/src/verbs/verbs_devinfo.rs
@@ -43,14 +43,33 @@ pub struct VerbsDeviceInfo {
 
 impl VerbsDeviceInfo {
     pub fn new(device_list: Arc<VerbsDeviceList>, device_index: usize) -> Self {
-        // TODO: port_num
-        // TODO: gid_index
-        Self { device_list, device_index, port_num: 1, gid_index: 0 }
+        // Prefer RoCE v2 routable GID (matches NCCL_IB_GID_INDEX=3 on this cluster).
+        // Override with FABRIC_GID_INDEX if needed.
+        let gid_index = std::env::var("FABRIC_GID_INDEX")
+            .ok()
+            .and_then(|s| s.parse().ok())
+            .unwrap_or(3);
+        Self { device_list, device_index, port_num: 1, gid_index }
     }
 
     pub fn device(&self) -> *mut ibv_device {
         unsafe { *self.device_list.list.add(self.device_index) }
     }
+
+    /// True if the verbs port is ACTIVE (sysfs state == 4).
+    pub fn is_port_active(&self) -> bool {
+        let path = format!(
+            "{}/ports/{}/state",
+            unsafe {
+                CStr::from_ptr((*self.device()).ibdev_path.as_ptr()).to_string_lossy()
+            },
+            self.port_num
+        );
+        match std::fs::read_to_string(path) {
+            Ok(content) => content.trim().starts_with("4:"),
+            Err(_) => false,
+        }
+    }
 }
 
